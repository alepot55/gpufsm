+module attributes {"ttg.num-warps" = 4 : i32, "ttg.num-ctas" = 1 : i32, ttg.target = "cuda:90"} {
+
+// The op has no scratch buffer, so the CTA-wide barriers the lowering emits on
+// entry to the default region order the store against the load.
+// CHECK-LABEL: @warp_specialize_entry_is_a_sync_point
+tt.func @warp_specialize_entry_is_a_sync_point(%arg0: tensor<1xi64>) {
+  // CHECK-NEXT: local_alloc
+  %0 = ttg.local_alloc : () -> !ttg.memdesc<1xi64, #layout, #smem, mutable>
+  // CHECK-NEXT: local_store
+  ttg.local_store %arg0, %0 : tensor<1xi64> -> !ttg.memdesc<1xi64, #layout, #smem, mutable>
+  // CHECK-NEXT: warp_specialize
+  ttg.warp_specialize()
+  // CHECK-NEXT: default
+  default {
+    // CHECK-NEXT: local_load
+    ttg.local_load %0 : !ttg.memdesc<1xi64, #layout, #smem, mutable> -> tensor<1xi64>
+    // CHECK-NEXT: warp_yield
+    ttg.warp_yield
+  // CHECK-NEXT: () -> ()
+  } : () -> ()
+  tt.return
+}
+
+// Same op, but the concurrency sanitizer reserved capture bytes on it, so it
+// does own a scratch buffer. The stores into that buffer happen before those
+// barriers, so the read of the buffer the allocator placed on the same bytes
+// still needs one. Note the reservation does not change getCaptureSize().
+// CHECK-LABEL: @warp_specialize_with_capture_scratch
+tt.func @warp_specialize_with_capture_scratch(%arg0: tensor<1xi64>) {
+  // CHECK-NEXT: local_alloc
+  %0 = ttg.local_alloc : () -> !ttg.memdesc<1xi64, #layout, #smem, mutable>
+  // CHECK-NEXT: local_store
+  ttg.local_store %arg0, %0 : tensor<1xi64> -> !ttg.memdesc<1xi64, #layout, #smem, mutable>
+  // CHECK-NEXT: ttg.barrier local
+  // CHECK-NEXT: local_load
+  ttg.local_load %0 : !ttg.memdesc<1xi64, #layout, #smem, mutable> -> tensor<1xi64>
+  // CHECK-NEXT: ttg.barrier local
+  // CHECK-NEXT: warp_specialize
+  ttg.warp_specialize() attributes {"consan.extra_capture_bytes" = 256 : i32}
+  // CHECK-NEXT: default
+  default {
+    // CHECK-NEXT: warp_yield
+    ttg.warp_yield
+  // CHECK-NEXT: () -> ()
+  } : () -> ()
+  tt.return
+}
+
+}
+
