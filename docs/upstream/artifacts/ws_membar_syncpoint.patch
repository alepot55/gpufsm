diff --git a/lib/Analysis/Membar.cpp b/lib/Analysis/Membar.cpp
index d8096c180..0f3b4a4e6 100644
--- a/lib/Analysis/Membar.cpp
+++ b/lib/Analysis/Membar.cpp
@@ -175,6 +175,23 @@ static triton::BarrierStages getLocalBarrierStages(Operation *op,
   // write and read phases. Other barrier-like operations behave as a barrier
   // immediately before the operation.
   stages.betweenMemoryEffects = hasScratchBarrier;
+
+  // `ttg.warp_specialize` lowers to two CTA-wide barriers sitting between the
+  // capture stores and the branch into the default region (lowerWarpSpecialize
+  // in lib/Conversion/TritonGPUToLLVM/WarpSpecializeUtility.cpp), so incoming
+  // shared memory effects are already synchronized when the region starts.
+  //
+  // This is keyed on the op having no scratch buffer rather than on it having no
+  // captures: when it owns one, the capture stores into that buffer precede
+  // those barriers, and the rendezvous that matters is the `betweenMemoryEffects`
+  // one above. The two conditions are not interchangeable, because backends
+  // override the scratch size and the concurrency sanitizer reserves capture
+  // bytes on every `warp_specialize` regardless of its captures.
+  if (isa<triton::gpu::WarpSpecializeOp>(op)) {
+    stages.beforeMemoryEffects = !hasScratchBarrier;
+    return stages;
+  }
+
   stages.beforeMemoryEffects = containsLocalBarrier(op);
   return stages;
 }
